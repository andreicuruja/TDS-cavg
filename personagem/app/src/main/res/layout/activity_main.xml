<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="441dp"
        android:layout_height="800dp"
        android:layout_marginBottom="32dp"
        android:alpha="0.2"
        android:scaleX="4"
        android:scaleY="4"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/backgroundbz" />

    <TextView
        android:id="@+id/textoPersonagem"
        android:layout_width="76dp"
        android:layout_height="27dp"
        android:accessibilityHeading="false"
        android:imeOptions="flagNoAccessoryAction"
        android:text="@string/textoPersonagem"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:visibility="visible"
        tools:layout_editor_absoluteX="183dp"
        tools:layout_editor_absoluteY="566dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="216dp"
        android:layout_height="498dp"
        android:contentDescription="@string/app_name"
        android:visibility="visible"
        app:constraint_referenced_tags="@string/app_name"
        app:srcCompat="@drawable/gohanaura"
        tools:layout_editor_absoluteX="113dp"
        tools:layout_editor_absoluteY="49dp" />

</androidx.constraintlayout.widget.ConstraintLayout>